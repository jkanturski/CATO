#!/bin/bash
#BSUB -J crypto_tcn_12gpu
#BSUB -q gpu
#BSUB -W 08:00
#BSUB -n 12
#BSUB -R "span[ptile=4]"
#BSUB -gpu "num=4:mode=exclusive_process"
#BSUB -o logs/train_%J.out
#BSUB -e logs/train_%J.err

# Load environment (adjust paths/modules to your CATO configuration)
# module load cuda python
# source /home/jkanturski/uksw/CATO/dl/venv/bin/activate

WORK_DIR="/home/jkanturski/uksw/CATO/dl"
cd $WORK_DIR

# Extract the unique hostnames allocated by Spectrum LSF
HOST_LIST=$(cat $LSB_DJOB_HOSTFILE | sort | uniq)

# Define rendezvous parameters for PyTorch distributed backend
MASTER_ADDR=$(echo "$HOST_LIST" | head -n 1)
MASTER_PORT=29500
NNODES=$(echo "$HOST_LIST" | wc -l)
NGPUS_PER_NODE=4

echo "--- Distributed Training Initialized ---"
echo "Master node: $MASTER_ADDR"
echo "Total nodes: $NNODES"
echo "GPUs per node: $NGPUS_PER_NODE"
echo "Job ID: $LSB_JOBID"

# Loop through each allocated node and launch torchrun via blaunch
NODE_RANK=0
for NODE in $HOST_LIST; do
    echo "Spawning torchrun on $NODE (Node Rank: $NODE_RANK)..."
    
    blaunch -z "$NODE" torchrun \
        --nnodes=$NNODES \
        --nproc_per_node=$NGPUS_PER_NODE \
        --node_rank=$NODE_RANK \
        --rdzv_id=$LSB_JOBID \
        --rdzv_backend=c10d \
        --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
        train.py &
        
    NODE_RANK=$((NODE_RANK + 1))
done

# Wait for all background blaunch processes to finish
wait
